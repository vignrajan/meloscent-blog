---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import ScentSageHeader from '../components/ScentSageHeader.astro';
import ScentSageFooter from '../components/ScentSageFooter.astro';
import FormattedDate from '../components/FormattedDate.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
	</head>

	<body class="min-h-screen bg-cream text-charcoal">
		<ScentSageHeader />
		
		<main class="pt-24">
			<article class="container mx-auto px-4 py-8">
				{heroImage && (
					<div class="hero-image mb-8">
						<img 
							width={1020} 
							height={510} 
							src={heroImage} 
							alt={title}
							class="w-full max-w-4xl mx-auto rounded-lg shadow-lg object-cover"
						/>
					</div>
				)}
				
				<div class="prose max-w-4xl mx-auto">
					<header class="text-center mb-8">
						<div class="text-amber-700 mb-2">
							<FormattedDate date={pubDate} />
							{updatedDate && (
								<div class="text-sm italic text-gray-600 mt-1">
									Last updated on <FormattedDate date={updatedDate} />
								</div>
							)}
						</div>
						<h1 class="font-serif text-4xl md:text-5xl font-bold text-amber-900 mb-4">{title}</h1>
						<div class="w-24 h-1 bg-amber-700 mx-auto"></div>
					</header>
					
					<div class="prose prose-lg prose-amber max-w-none">
						<slot />
					</div>
				</div>
			</article>
		</main>
		
		<ScentSageFooter />
	</body>
</html>

<style>
	.prose {
		color: rgb(55 65 81);
		line-height: 1.75;
	}
	
	.prose h1, .prose h2, .prose h3, .prose h4, .prose h5, .prose h6 {
		color: rgb(146 64 14);
		font-family: Georgia, Cambria, 'Times New Roman', Times, serif;
		font-weight: 600;
		margin-top: 2em;
		margin-bottom: 1em;
	}
	
	.prose p {
		margin-bottom: 1.5em;
	}
	
	.prose a {
		color: rgb(180 83 9);
		text-decoration: underline;
	}
	
	.prose a:hover {
		color: rgb(146 64 14);
	}
	
	.prose blockquote {
		border-left: 4px solid rgb(180 83 9);
		padding-left: 1.5rem;
		font-style: italic;
		color: rgb(75 85 99);
	}
	
	.prose code {
		background-color: rgb(254 243 199);
		padding: 0.25rem 0.5rem;
		border-radius: 0.25rem;
		font-size: 0.875em;
	}
	
	.prose pre {
		background-color: rgb(55 65 81);
		color: white;
		padding: 1.5rem;
		border-radius: 0.5rem;
		overflow-x: auto;
	}
	
	.prose pre code {
		background-color: transparent;
		padding: 0;
	}
</style>