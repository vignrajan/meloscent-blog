---
import BaseHead from "../components/BaseHead.astro";
import ScentSageHeader from "../components/ScentSageHeader.astro";
import ScentSageFooter from "../components/ScentSageFooter.astro";
import Newsletter from "../components/Newsletter.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { getCollection } from "astro:content";
import FormattedDate from "../components/FormattedDate.astro";

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body class="min-h-screen bg-cream text-charcoal">
		<ScentSageHeader />

		<!-- Hero Section -->
		<section class="relative h-screen flex items-center">
			<div class="absolute inset-0 z-0 overflow-hidden">
				<img
					src="https://images.pexels.com/photos/965989/pexels-photo-965989.jpeg?auto=compress&cs=tinysrgb&w=1440&h=800&fit=crop"
					alt="Luxury perfume background"
					class="w-full h-full object-cover object-center"
				/>
				<div
					class="absolute inset-0 bg-gradient-to-r from-amber-900/80 to-transparent"
				>
				</div>
			</div>

			<div class="container mx-auto px-4 relative z-10">
				<div class="max-w-2xl text-white">
					<h1
						class="font-serif text-5xl md:text-6xl font-bold mb-4 leading-tight"
					>
						Discover the Art of Fragrance
					</h1>
					<p class="text-lg md:text-xl mb-8 text-amber-50">
						Exploring the world of original designer perfumes and
						their affordable alternatives.
					</p>
					<div class="flex flex-col sm:flex-row gap-4">
						<a
							href="/blog"
							class="bg-amber-700 hover:bg-amber-800 text-white px-6 py-3 rounded-button transition-colors text-center"
						>
							Explore Reviews
						</a>
						<a
							href="/blog/markdown-style-guide"
							class="bg-transparent border-2 border-white hover:bg-white/10 text-white px-6 py-3 rounded-button transition-colors text-center"
						>
							Beginner's Guide
						</a>
					</div>
				</div>
			</div>

			<div
				class="absolute bottom-8 left-1/2 transform -translate-x-1/2 text-white animate-bounce"
			>
				<i class="fas fa-chevron-down"></i>
			</div>
		</section>

		<!-- Category Showcase -->
		<section class="py-16 bg-white">
			<div class="container mx-auto px-4">
				<h2
					class="font-serif text-3xl md:text-4xl text-center mb-12 text-amber-900"
				>
					Explore Our Categories
				</h2>

				<div class="grid grid-cols-2 md:grid-cols-4 gap-6">
					<div
						class="group relative rounded-lg overflow-hidden shadow-md transition-all duration-300 hover:shadow-xl cursor-pointer"
					>
						<div class="absolute inset-0 overflow-hidden">
							<img
								src="https://images.pexels.com/photos/1190829/pexels-photo-1190829.jpeg?auto=compress&cs=tinysrgb&w=400&h=300&fit=crop"
								alt="Originals"
								class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"
							>
							</div>
						</div>
						<div
							class="relative p-6 flex flex-col items-center text-center h-full justify-end"
						>
							<i class="fas fa-crown text-amber-300 text-3xl mb-3"
							></i>
							<h3 class="font-serif text-xl text-white mb-1">
								Originals
							</h3>
							<p class="text-amber-100 text-sm hidden md:block">
								Luxury designer fragrances
							</p>
						</div>
					</div>

					<div
						class="group relative rounded-lg overflow-hidden shadow-md transition-all duration-300 hover:shadow-xl cursor-pointer"
					>
						<div class="absolute inset-0 overflow-hidden">
							<img
								src="https://images.pexels.com/photos/1961795/pexels-photo-1961795.jpeg?auto=compress&cs=tinysrgb&w=400&h=300&fit=crop"
								alt="Clones"
								class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"
							>
							</div>
						</div>
						<div
							class="relative p-6 flex flex-col items-center text-center h-full justify-end"
						>
							<i class="fas fa-copy text-amber-300 text-3xl mb-3"
							></i>
							<h3 class="font-serif text-xl text-white mb-1">
								Clones
							</h3>
							<p class="text-amber-100 text-sm hidden md:block">
								Affordable alternatives
							</p>
						</div>
					</div>

					<div
						class="group relative rounded-lg overflow-hidden shadow-md transition-all duration-300 hover:shadow-xl cursor-pointer"
					>
						<div class="absolute inset-0 overflow-hidden">
							<img
								src="https://images.pexels.com/photos/1190829/pexels-photo-1190829.jpeg?auto=compress&cs=tinysrgb&w=400&h=300&fit=crop"
								alt="Reviews"
								class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"
							>
							</div>
						</div>
						<div
							class="relative p-6 flex flex-col items-center text-center h-full justify-end"
						>
							<i class="fas fa-star text-amber-300 text-3xl mb-3"
							></i>
							<h3 class="font-serif text-xl text-white mb-1">
								Reviews
							</h3>
							<p class="text-amber-100 text-sm hidden md:block">
								Expert fragrance analysis
							</p>
						</div>
					</div>

					<div
						class="group relative rounded-lg overflow-hidden shadow-md transition-all duration-300 hover:shadow-xl cursor-pointer"
					>
						<div class="absolute inset-0 overflow-hidden">
							<img
								src="https://images.pexels.com/photos/965989/pexels-photo-965989.jpeg?auto=compress&cs=tinysrgb&w=400&h=300&fit=crop"
								alt="Top 10s"
								class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-110"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-black/70 to-transparent"
							>
							</div>
						</div>
						<div
							class="relative p-6 flex flex-col items-center text-center h-full justify-end"
						>
							<i
								class="fas fa-list-ol text-amber-300 text-3xl mb-3"
							></i>
							<h3 class="font-serif text-xl text-white mb-1">
								Top 10s
							</h3>
							<p class="text-amber-100 text-sm hidden md:block">
								Best fragrances by category
							</p>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Featured Articles -->
		<section class="py-16 bg-amber-50">
			<div class="container mx-auto px-4">
				<div class="flex justify-between items-center mb-12">
					<h2 class="font-serif text-3xl md:text-4xl text-amber-900">
						Featured Articles
					</h2>
					<a
						href="/blog"
						class="text-amber-700 hover:text-amber-900 transition-colors flex items-center cursor-pointer"
					>
						View all <i class="fas fa-arrow-right ml-2"></i>
					</a>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
					{
						posts.map((post) => (
							<div class="bg-white rounded-lg overflow-hidden shadow-md hover:shadow-xl transition-all duration-300 cursor-pointer">
								<div class="relative h-60 overflow-hidden">
									<img
										src={
											post.data.heroImage ||
											"/blog-placeholder-1.jpg"
										}
										alt={post.data.title}
										class="w-full h-full object-cover object-center transition-transform duration-500 hover:scale-105"
									/>
									<span class="absolute top-4 left-4 bg-amber-700 text-white text-xs px-3 py-1 rounded-full">
										Featured
									</span>
								</div>
								<div class="p-6">
									<h3 class="font-serif text-xl font-semibold mb-3 text-amber-900 line-clamp-2">
										{post.data.title}
									</h3>
									<div class="flex items-center text-sm text-gray-600 mb-4">
										<div class="w-8 h-8 bg-amber-200 rounded-full flex items-center justify-center mr-3">
											<span class="text-amber-800 font-serif">
												S
											</span>
										</div>
										<span>MeloScent Team</span>
										<span class="mx-2">•</span>
										<FormattedDate
											date={post.data.pubDate}
										/>
									</div>
									<a
										href={`/blog/${post.id}/`}
										class="text-amber-700 hover:text-amber-900 transition-colors flex items-center text-sm font-medium cursor-pointer"
									>
										Read Article{" "}
										<i class="fas fa-long-arrow-alt-right ml-2" />
									</a>
								</div>
							</div>
						))
					}
				</div>
			</div>
		</section>

		<Newsletter />
		<ScentSageFooter />
	</body>
</html>
