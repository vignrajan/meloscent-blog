---
import BaseHead from "../components/BaseHead.astro";
import ScentSageHeader from "../components/ScentSageHeader.astro";
import ScentSageFooter from "../components/ScentSageFooter.astro";
import { SITE_TITLE } from "../consts";
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About - ${SITE_TITLE}`}
			description="Learn about MeloScent and our passion for fragrances"
		/>
	</head>
	<body class="min-h-screen bg-cream text-charcoal">
		<ScentSageHeader />

		<main class="pt-24">
			<div class="container mx-auto px-4 py-16">
				<div class="max-w-4xl mx-auto">
					<div class="text-center mb-12">
						<h1
							class="font-serif text-4xl md:text-5xl font-bold text-amber-900 mb-4"
						>
							About MeloScent
						</h1>
						<div class="w-24 h-1 bg-amber-700 mx-auto mb-6"></div>
						<p class="text-lg text-gray-600">
							Your trusted guide to the world of fragrances
						</p>
					</div>

					<div
						class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center mb-16"
					>
						<div>
							<img
								src="https://images.pexels.com/photos/965989/pexels-photo-965989.jpeg?auto=compress&cs=tinysrgb&w=600&h=400&fit=crop"
								alt="About ScentSage"
								class="w-full rounded-lg shadow-lg"
							/>
						</div>
						<div>
							<h2
								class="font-serif text-2xl font-semibold text-amber-900 mb-4"
							>
								Our Mission
							</h2>
							<p class="text-gray-600 mb-6">
								At MeloScent, we believe that everyone deserves
								to smell amazing without breaking the bank. Our
								mission is to bridge the gap between luxury
								fragrances and affordable alternatives, helping
								fragrance enthusiasts make informed decisions.
							</p>
							<p class="text-gray-600">
								We provide honest, detailed reviews of both
								original designer perfumes and their
								high-quality clones, ensuring you get the best
								value for your money while discovering your
								signature scent.
							</p>
						</div>
					</div>

					<div class="bg-white rounded-lg p-8 shadow-md mb-16">
						<h2
							class="font-serif text-2xl font-semibold text-amber-900 mb-6 text-center"
						>
							What We Offer
						</h2>
						<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
							<div class="text-center">
								<i
									class="fas fa-star text-amber-700 text-3xl mb-4"
								></i>
								<h3
									class="font-serif text-lg font-semibold text-amber-900 mb-2"
								>
									Expert Reviews
								</h3>
								<p class="text-gray-600 text-sm">
									In-depth analysis of fragrances, including
									performance, longevity, and value for money.
								</p>
							</div>
							<div class="text-center">
								<i
									class="fas fa-balance-scale text-amber-700 text-3xl mb-4"
								></i>
								<h3
									class="font-serif text-lg font-semibold text-amber-900 mb-2"
								>
									Honest Comparisons
								</h3>
								<p class="text-gray-600 text-sm">
									Side-by-side comparisons between original
									designer fragrances and their alternatives.
								</p>
							</div>
							<div class="text-center">
								<i
									class="fas fa-graduation-cap text-amber-700 text-3xl mb-4"
								></i>
								<h3
									class="font-serif text-lg font-semibold text-amber-900 mb-2"
								>
									Educational Content
								</h3>
								<p class="text-gray-600 text-sm">
									Guides and tips to help you understand
									fragrances and build your collection.
								</p>
							</div>
						</div>
					</div>

					<div class="text-center">
						<h2
							class="font-serif text-2xl font-semibold text-amber-900 mb-4"
						>
							Join Our Community
						</h2>
						<p class="text-gray-600 mb-6">
							Whether you're a fragrance novice or a seasoned
							collector, MeloScent is here to guide you on your
							olfactory journey. Join thousands of fragrance
							enthusiasts who trust our reviews and
							recommendations.
						</p>
						<a
							href="/blog"
							class="bg-amber-700 hover:bg-amber-800 text-white px-6 py-3 rounded-button transition-colors"
						>
							Explore Our Reviews
						</a>
					</div>
				</div>
			</div>
		</main>

		<ScentSageFooter />
	</body>
</html>
