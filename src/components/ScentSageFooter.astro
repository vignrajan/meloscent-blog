---
const today = new Date();
---

<footer class="bg-gray-900 text-white py-12">
  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <div>
        <h3 class="font-serif text-2xl font-bold mb-4 text-amber-400">
          MeloScent
        </h3>
        <p class="text-gray-400 mb-4">
          Your trusted guide to the world of fragrances, from luxury originals
          to affordable alternatives.
        </p>
        <div class="flex space-x-4">
          <a
            href="#"
            class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
          >
            <i class="fab fa-facebook-f"></i>
          </a>
          <a
            href="#"
            class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
          >
            <i class="fab fa-twitter"></i>
          </a>
          <a
            href="#"
            class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
          >
            <i class="fab fa-instagram"></i>
          </a>
          <a
            href="#"
            class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
          >
            <i class="fab fa-pinterest"></i>
          </a>
        </div>
      </div>

      <div>
        <h4 class="font-serif text-lg font-semibold mb-4 text-white">
          Quick Links
        </h4>
        <ul class="space-y-2">
          <li>
            <a
              href="/"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Home</a
            >
          </li>
          <li>
            <a
              href="/about"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >About Us</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Reviews</a
            >
          </li>
          <li>
            <a
              href="/blog"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Comparisons</a
            >
          </li>
          <li>
            <a
              href="#contact"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Contact</a
            >
          </li>
        </ul>
      </div>

      <div>
        <h4 class="font-serif text-lg font-semibold mb-4 text-white">
          Recent Posts
        </h4>
        <ul class="space-y-3">
          <li>
            <a
              href="/blog/using-mdx"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Summer Fragrances 2025: Top 5 Scents</a
            >
            <p class="text-xs text-gray-500">June 5, 2025</p>
          </li>
          <li>
            <a
              href="/blog/first-post"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >Is Creed Aventus Worth the Premium?</a
            >
            <p class="text-xs text-gray-500">June 2, 2025</p>
          </li>
          <li>
            <a
              href="/blog/markdown-style-guide"
              class="text-gray-400 hover:text-amber-400 transition-colors cursor-pointer"
              >The Art of Layering Fragrances</a
            >
            <p class="text-xs text-gray-500">May 28, 2025</p>
          </li>
        </ul>
      </div>

      <div id="contact">
        <h4 class="font-serif text-lg font-semibold mb-4 text-white">
          Contact Us
        </h4>
        <ul class="space-y-3 text-gray-400">
          <li class="flex items-start">
            <i class="fas fa-envelope mt-1 mr-3 text-amber-400"></i>
            <span>info@meloscent.com</span>
          </li>
          <li class="flex items-start">
            <i class="fas fa-map-marker-alt mt-1 mr-3 text-amber-400"></i>
            <span>123 Fragrance Lane, Perfume City, 90210</span>
          </li>
          <li class="flex items-start">
            <i class="fas fa-phone-alt mt-1 mr-3 text-amber-400"></i>
            <span>+1 (555) 123-4567</span>
          </li>
        </ul>
      </div>
    </div>

    <div
      class="border-t border-gray-800 mt-10 pt-6 flex flex-col md:flex-row justify-between items-center"
    >
      <p class="text-gray-500 text-sm mb-4 md:mb-0">
        © {today.getFullYear()} MeloScent. All rights reserved.
      </p>
      <div class="flex space-x-4 text-sm text-gray-500">
        <a
          href="#"
          class="hover:text-amber-400 transition-colors cursor-pointer"
          >Privacy Policy</a
        >
        <a
          href="#"
          class="hover:text-amber-400 transition-colors cursor-pointer"
          >Terms of Service</a
        >
        <a
          href="#"
          class="hover:text-amber-400 transition-colors cursor-pointer"
          >Cookie Policy</a
        >
      </div>
    </div>
  </div>
</footer>

<!-- Back to Top Button -->
<button
  id="back-to-top"
  class="fixed bottom-6 right-6 bg-amber-700 hover:bg-amber-800 text-white w-12 h-12 rounded-full flex items-center justify-center shadow-lg transition-all duration-300 cursor-pointer z-50"
>
  <i class="fas fa-arrow-up"></i>
</button>

<script>
  document.getElementById("back-to-top")?.addEventListener("click", () => {
    window.scrollTo({ top: 0, behavior: "smooth" });
  });
</script>
