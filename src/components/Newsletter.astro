---

---

<section class="py-16 bg-gradient-to-r from-amber-800 to-amber-900 text-white">
  <div class="container mx-auto px-4 text-center">
    <h2 class="font-serif text-3xl md:text-4xl mb-4">
      Stay Updated with MeloScent
    </h2>
    <p class="max-w-2xl mx-auto mb-8">
      Subscribe to our newsletter for the latest fragrance reviews, comparisons,
      and exclusive content delivered straight to your inbox.
    </p>

    <form id="newsletter-form" class="max-w-md mx-auto relative">
      <div class="flex">
        <input
          type="email"
          id="email-input"
          placeholder="Your email address"
          class="w-full px-4 py-3 rounded-l-button text-gray-800 border-none focus:outline-none focus:ring-2 focus:ring-amber-500"
          required
        />
        <button
          type="submit"
          class="bg-amber-700 hover:bg-amber-600 px-6 py-3 rounded-r-button transition-colors cursor-pointer whitespace-nowrap"
        >
          Subscribe
        </button>
      </div>
      <div
        id="success-message"
        class="absolute -bottom-8 left-0 right-0 text-amber-200 text-sm hidden"
      >
        Thank you for subscribing!
      </div>
      <p class="text-xs mt-4 text-amber-200">
        By subscribing, you agree to our Privacy Policy. We respect your
        privacy.
      </p>
    </form>
  </div>
</section>

<script>
  document
    .getElementById("newsletter-form")
    ?.addEventListener("submit", (e) => {
      e.preventDefault();
      const emailInput = document.getElementById(
        "email-input",
      ) as HTMLInputElement;
      const successMessage = document.getElementById("success-message");

      if (emailInput?.value) {
        successMessage?.classList.remove("hidden");
        emailInput.value = "";
        setTimeout(() => {
          successMessage?.classList.add("hidden");
        }, 3000);
      }
    });
</script>
