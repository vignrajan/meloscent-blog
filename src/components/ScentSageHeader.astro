---
import { SITE_TITLE } from "../consts";
---

<header
  id="header"
  class="fixed w-full z-50 transition-all duration-300 bg-transparent py-5"
>
  <div class="container mx-auto px-4 flex justify-between items-center">
    <a href="/" class="text-3xl font-serif font-bold text-amber-800"
      >{SITE_TITLE}</a
    >

    <!-- Desktop Navigation -->
    <nav class="hidden md:flex items-center space-x-8">
      <a
        href="/"
        class="font-serif text-amber-900 hover:text-amber-700 transition-colors"
        >Home</a
      >
      <div class="relative group">
        <button
          class="font-serif text-amber-900 hover:text-amber-700 transition-colors flex items-center"
        >
          Reviews
          <i class="fas fa-chevron-down text-xs ml-1"></i>
        </button>
        <div
          class="absolute left-0 mt-2 w-48 bg-white shadow-lg rounded-md opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300"
        >
          <a href="/blog" class="block px-4 py-2 text-sm hover:bg-amber-50"
            >Originals</a
          >
          <a href="/blog" class="block px-4 py-2 text-sm hover:bg-amber-50"
            >Clones</a
          >
          <a href="/blog" class="block px-4 py-2 text-sm hover:bg-amber-50"
            >Top 10s</a
          >
        </div>
      </div>
      <a
        href="/blog"
        class="font-serif text-amber-900 hover:text-amber-700 transition-colors"
        >Guides</a
      >
      <a
        href="/about"
        class="font-serif text-amber-900 hover:text-amber-700 transition-colors"
        >About</a
      >
      <a
        href="#contact"
        class="font-serif text-amber-900 hover:text-amber-700 transition-colors"
        >Contact</a
      >
    </nav>

    <div class="flex items-center space-x-4">
      <button
        class="text-amber-900 hover:text-amber-700 transition-colors cursor-pointer"
      >
        <i class="fas fa-search text-lg"></i>
      </button>
      <button
        class="hidden md:block bg-amber-700 hover:bg-amber-800 text-white px-4 py-2 rounded-button transition-colors cursor-pointer whitespace-nowrap"
      >
        Subscribe
      </button>
      <button
        id="mobile-menu-toggle"
        class="md:hidden text-amber-900 cursor-pointer"
      >
        <i class="fas fa-bars text-xl"></i>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation -->
  <div
    id="mobile-menu"
    class="md:hidden bg-white absolute w-full shadow-lg transition-all duration-300 max-h-0 overflow-hidden"
  >
    <div class="container mx-auto px-4 flex flex-col space-y-3 py-4">
      <a
        href="/"
        class="font-serif text-amber-900 py-2 border-b border-amber-100">Home</a
      >
      <div class="py-2 border-b border-amber-100">
        <button
          class="font-serif text-amber-900 flex items-center justify-between w-full"
        >
          Reviews
          <i class="fas fa-chevron-down text-xs"></i>
        </button>
        <div class="pl-4 mt-2 space-y-2">
          <a href="/blog" class="block text-sm py-1">Originals</a>
          <a href="/blog" class="block text-sm py-1">Clones</a>
          <a href="/blog" class="block text-sm py-1">Top 10s</a>
        </div>
      </div>
      <a
        href="/blog"
        class="font-serif text-amber-900 py-2 border-b border-amber-100"
        >Guides</a
      >
      <a
        href="/about"
        class="font-serif text-amber-900 py-2 border-b border-amber-100"
        >About</a
      >
      <a
        href="#contact"
        class="font-serif text-amber-900 py-2 border-b border-amber-100"
        >Contact</a
      >
      <button
        class="bg-amber-700 hover:bg-amber-800 text-white px-4 py-2 rounded-button transition-colors cursor-pointer whitespace-nowrap self-start mt-2"
      >
        Subscribe
      </button>
    </div>
  </div>
</header>

<script>
  // Header scroll effect
  function handleScroll() {
    const header = document.getElementById("header");
    if (window.scrollY > 50) {
      header?.classList.add("bg-white", "shadow-md", "py-3");
      header?.classList.remove("bg-transparent", "py-5");
    } else {
      header?.classList.remove("bg-white", "shadow-md", "py-3");
      header?.classList.add("bg-transparent", "py-5");
    }
  }

  // Mobile menu toggle
  function toggleMobileMenu() {
    const menu = document.getElementById("mobile-menu");
    const toggle = document.getElementById("mobile-menu-toggle");
    const icon = toggle?.querySelector("i");

    if (menu?.classList.contains("max-h-0")) {
      menu.classList.remove("max-h-0");
      menu.classList.add("max-h-96");
      icon?.classList.remove("fa-bars");
      icon?.classList.add("fa-times");
    } else {
      menu?.classList.add("max-h-0");
      menu?.classList.remove("max-h-96");
      icon?.classList.add("fa-bars");
      icon?.classList.remove("fa-times");
    }
  }

  // Event listeners
  window.addEventListener("scroll", handleScroll);
  document
    .getElementById("mobile-menu-toggle")
    ?.addEventListener("click", toggleMobileMenu);
</script>
